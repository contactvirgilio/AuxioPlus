<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_item_bg"
    android:padding="@dimen/spacing_small">

    <org.oxycblt.auxio.image.CoverView
        android:id="@+id/tile_image"
        style="@style/Widget.Auxio.Image.Full"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tile_name"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_tiny"
        android:layout_marginTop="@dimen/spacing_small"
        android:textColor="@color/sel_selectable_text_primary"
        app:layout_constraintEnd_toStartOf="@+id/tile_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_image"
        tools:text="Album" />

    <TextView
        android:id="@+id/tile_info"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_tiny"
        app:layout_constraintEnd_toStartOf="@+id/tile_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_name"
        tools:text="Artist" />

    <org.oxycblt.auxio.ui.RippleFixMaterialButton
        android:id="@+id/tile_menu"
        style="@style/Widget.Auxio.Button.Icon.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/lbl_more"
        app:icon="@drawable/ic_more_24"
        app:layout_constraintBottom_toBottomOf="@+id/tile_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tile_name" />

</androidx.constraintlayout.widget.ConstraintLayout>
