<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visualizer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <org.oxycblt.auxio.playback.visualizer.VisualizerView
        android:id="@+id/visualizer_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:alwaysOn="true" />

    <TextView
        android:id="@+id/visualizer_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:alpha="0"
        android:background="@drawable/bg_visualizer_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <org.oxycblt.auxio.ui.MarqueeTextView
        android:id="@+id/visualizer_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_visualizer_pill_progress"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</FrameLayout>
